# Адрес сайта — используется в мета-тегах, sitemap и robots.
SITE_URL=https://torrential.app

# Куда ведут кнопки «Скачать». По умолчанию — страница релизов проекта.
NEXT_PUBLIC_DOWNLOAD_BASE=https://github.com/Futurizm/Torrential/releases/tag/torrent-client

# Версия в имени файлов сборок (Torrential-<version>-setup.exe).
NEXT_PUBLIC_VERSION=1.0.0
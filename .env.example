# Порт HTTP/WS сервера (движок WebTorrent + WebSocket-хаб)
PORT=8787

# Куда складывать загруженные данные
DOWNLOAD_DIR=./downloads

# Глобальные лимиты скорости в байтах/сек (-1 = без лимита)
TORRENTIAL_DOWNLOAD_LIMIT=-1
TORRENTIAL_UPLOAD_LIMIT=-1

# DHT: true/false
DHT=true

# µTP (UDP-транспорт): true/false — отключите, если система блокирует UDP
UTP=true

# Дополнительные трекеры через запятую (приватные/локальные сети)
TRACKERS=

# Хранить .torrent-файлы для восстановления сессии после перезапуска
PERSIST=true
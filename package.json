{
  "name": "torrential",
  "private": true,
  "version": "1.0.0",
  "description": "Torrential - minimalistic desktop torrent client",
  "type": "module",
  "main": "electron/main.cjs",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -k -n engine,ui -c magenta,cyan \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:web": "vite",
    "build": "tsc -p tsconfig.server.json && vite build",
    "start": "node dist-server/server/index.js",
    "serve": "npm run build && npm start",

    "desktop": "electron .",
    "desktop:dev": "npm run build && electron .",
    "desktop:pack": "npm run build && node scripts/stage-engine.mjs && electron-builder --dir",
    "desktop:dist": "npm run build && node scripts/stage-engine.mjs && electron-builder --win --x64",
    "icon": "node scripts/make-icon.mjs",
    "screenshots": "electron scripts/capture-screenshots.cjs",

    "site:dev": "npm --prefix frontend run dev",
    "site:build": "npm --prefix frontend run build",
    "site:start": "npm --prefix frontend run start",
    "site:typecheck": "npm --prefix frontend exec tsc -- --noEmit",

    "test": "npm run test:ui && npm run test:e2e",
    "test:ui": "tsx test/render.test.ts",
    "test:e2e": "node test/e2e.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.server.json --noEmit"
  },
  "dependencies": {
    "express": "^4.21.0",
    "webtorrent": "^3.0.21",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/ws": "^8.5.13",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "bittorrent-tracker": "^11.2.3",
    "concurrently": "^9.1.0",
    "create-torrent": "^6.1.3",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "framer-motion": "^11.11.0",
    "jsdom": "^29.1.1",
    "lucide-react": "^0.400.0",
    "postcss": "^8.4.49",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.7"
  }
}
